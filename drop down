<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        nav{
            background-color: darkgoldenrod;
        }
        ul{
            display: flex;
            font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
            /* font-family: 'Times New Roman', Times, serif; */
            font-size: large;
            font-weight: 100;
            justify-content: space-around;
            list-style-type: none;
            position: relative;
           
        }
        nav ul ul{
            display: none;
            position: absolute;
        }
        
        nav li:hover>ul{
            display: block;
            background-color: aqua;
            text-align: center;
        }
    </style>
</head>
<body>
    <nav>
        <ul>
            <li>home
                <ul>
                    <li>open</li>
                    <li>save</li>
                    <li>exit</li>
                </ul>
            </li>
            <li>service</li>
            <li>contact</li>
        </ul>
    </nav>
</body>
</html>
