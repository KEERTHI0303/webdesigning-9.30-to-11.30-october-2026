<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        li{
            position: relative;
        }
        nav ul ul{
            display: none;
            position: absolute;
        }
        nav li:hover>ul{
            display: block;
        }
    </style>
</head>
<body>
    <nav>
        <ul>
            <li ><a href="">home</a>
                <UL>
                    <li>file</li>
                    <li>open</li>
                    <li>save</li>
                </UL>
            </li>
            <li>action</li>
            <li>contact</li>
            <li>help</li>
            <li>service</li>
        </ul>
    </nav>
</body>
</html>












